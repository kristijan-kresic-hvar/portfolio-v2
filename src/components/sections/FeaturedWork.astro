---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import Card from '@/components/primitives/Card.astro';
import Container from '@/components/primitives/Container.astro';
import Link from '@/components/primitives/Link.astro';
import Section from '@/components/primitives/Section.astro';
import { selectFeaturedWork } from '@/lib/utils/featured-work';

interface Props {
  /** Test seam: getCollection() resolves empty under vitest (content layer
   * isn't hydrated in test mode), so tests inject entries directly. */
  entries?: CollectionEntry<'work'>[];
}

const entries = selectFeaturedWork(Astro.props.entries ?? (await getCollection('work')));
---

{
  /* Renders nothing while no entry is featured — a landing page shouldn't
    advertise an empty portfolio. Fills back in as soon as stubs/studies land. */
  entries.length > 0 && (
    <Section aria-labelledby="featured-work-heading">
      <Container width="wide">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <h2
            id="featured-work-heading"
            class="text-text-primary text-3xl font-bold tracking-tight"
          >
            Featured work
          </h2>
          <Link href="/work" class="group font-mono text-sm">
            All work
            <span
              aria-hidden="true"
              class="ease-standard inline-block transition-transform duration-(--duration-instant) group-hover:translate-x-0.5"
            >
              →
            </span>
          </Link>
        </div>
        <ul role="list" class="mt-10 grid gap-6 lg:grid-cols-3">
          {entries.map((entry) => (
            <li>
              {/* ponytail: unlinked until the detail route lands (KKD-22, Phase 5) */}
              <Card elevated class="flex h-full flex-col">
                <h3 class="text-text-primary text-lg font-semibold">{entry.data.title}</h3>
                <p class="text-text-secondary mt-3 text-pretty">{entry.data.outcome}</p>
                <p class="text-text-body mt-3 text-sm text-pretty">{entry.data.summary}</p>
                <p class="text-text-muted mt-auto pt-6 font-mono text-xs leading-relaxed">
                  {[entry.data.role, ...entry.data.stack, String(entry.data.year)].join(' · ')}
                </p>
              </Card>
            </li>
          ))}
        </ul>
      </Container>
    </Section>
  )
}
