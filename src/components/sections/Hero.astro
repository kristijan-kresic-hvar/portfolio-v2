---
import { Picture } from 'astro:assets';

import headshot from '@/assets/headshot-no-bg.png';
import Button from '@/components/primitives/Button.astro';
import Container from '@/components/primitives/Container.astro';
import Section from '@/components/primitives/Section.astro';
---

{
  /* overflow-x-clip: the depth field + the portrait's xl right-bleed extend past
    the container and would cause horizontal scroll otherwise */
}
{
  /* lg:py-0! — needs the important modifier to beat Section's own lg:py-24
    (same specificity, later in the generated CSS); the grid's min-h owns the
    full-viewport height at lg instead */
}
<Section class="hero-section relative isolate overflow-x-clip lg:py-0!">
  <div class="hero-field absolute inset-0 -z-10" aria-hidden="true"></div>
  {
    /* Constellation backdrop (KKD-34, pattern adapted from designwithintent.ai):
      an irregular star-map scatter — short connecting hairlines at varied angles
      between genuinely nearby nodes, one dashed drift arc, deliberately NO
      axis-aligned strokes (the blueprint rules/ticks died in review: "weird
      straight vertical lines"). Because the hero's layout changes shape per
      breakpoint (stacked / stacked-wide / split), the field is authored THREE
      times — .fx-sm / .fx-tab / .fx-desk — each placed against the measured
      empty zones of that layout (coordinates probed in-browser at 375/768/1280).
      Node radii stay in px so dots never balloon. At rest the field is
      near-hidden; a fine pointer reveals it locally via the --mx/--my mask
      (script at the bottom of this file). */
  }
  <svg
    class="hero-fx pointer-events-none absolute inset-0 -z-10 h-full w-full"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
  >
    <g class="fx-sm">
      {
        /* mobile: strip above the h1, the h1's ragged right edge, the gap above
        the portrait, and the bottom dissolve zone */
      }
      <line class="fx-line" x1="12%" y1="2.1%" x2="20%" y2="4.3%"></line>
      <line class="fx-line" x1="20%" y1="4.3%" x2="29%" y2="1.7%"></line>
      <line class="fx-line" x1="42%" y1="3.9%" x2="52%" y2="1.9%"></line>
      <line class="fx-line" x1="67%" y1="15.8%" x2="76%" y2="13.2%"></line>
      <line class="fx-line" x1="76%" y1="13.2%" x2="85%" y2="16.4%"></line>
      <line class="fx-line" x1="13%" y1="62.8%" x2="23%" y2="60.9%"></line>
      <line class="fx-line" x1="23%" y1="60.9%" x2="34%" y2="63.4%"></line>
      <line class="fx-line" x1="56%" y1="97.2%" x2="68%" y2="95.3%"></line>
      <line class="fx-line" x1="68%" y1="95.3%" x2="79%" y2="97.8%"></line>
      <circle class="fx-node" cx="12%" cy="2.1%" r="1.5"></circle>
      <circle class="fx-node" cx="20%" cy="4.3%" r="2"></circle>
      <circle class="fx-node" cx="42%" cy="3.9%" r="2"></circle>
      <circle class="fx-node" cx="52%" cy="1.9%" r="1.5"></circle>
      <circle class="fx-node" cx="67%" cy="15.8%" r="1.5"></circle>
      <circle class="fx-node" cx="76%" cy="13.2%" r="2"></circle>
      <circle class="fx-node" cx="85%" cy="16.4%" r="1.5"></circle>
      <circle class="fx-node" cx="13%" cy="62.8%" r="1.5"></circle>
      <circle class="fx-node" cx="34%" cy="63.4%" r="2"></circle>
      <circle class="fx-node" cx="56%" cy="97.2%" r="1.5"></circle>
      <circle class="fx-node" cx="68%" cy="95.3%" r="2"></circle>
      <circle class="fx-node" cx="79%" cy="97.8%" r="1.5"></circle>
      <circle class="fx-node fx-amber" cx="29%" cy="1.7%" r="2"></circle>
      <circle class="fx-node fx-amber" cx="23%" cy="60.9%" r="2"></circle>
    </g>
    <g class="fx-tab">
      {
        /* tablet: top strip zigzag, the subheadline's right gap, both portrait
        side gutters, bottom dissolve + drift arc behind the portrait base */
      }
      <line class="fx-line" x1="8%" y1="3.2%" x2="14%" y2="6.1%"></line>
      <line class="fx-line" x1="14%" y1="6.1%" x2="22%" y2="2.4%"></line>
      <line class="fx-line" x1="31%" y1="5.4%" x2="40%" y2="2.8%"></line>
      <line class="fx-line" x1="52%" y1="6%" x2="61%" y2="3.4%"></line>
      <line class="fx-line" x1="72%" y1="5.8%" x2="83%" y2="2.6%"></line>
      <line class="fx-line" x1="83%" y1="2.6%" x2="91%" y2="5.2%"></line>
      <line class="fx-line" x1="81%" y1="22%" x2="88%" y2="25.3%"></line>
      <line class="fx-line" x1="5%" y1="56%" x2="10%" y2="61.5%"></line>
      <line class="fx-line" x1="10%" y1="61.5%" x2="4.5%" y2="68%"></line>
      <line class="fx-line" x1="4.5%" y1="68%" x2="9.5%" y2="74.5%"></line>
      <line class="fx-line" x1="94%" y1="54%" x2="89.5%" y2="60.5%"></line>
      <line class="fx-line" x1="89.5%" y1="60.5%" x2="95%" y2="67.5%"></line>
      <line class="fx-line" x1="95%" y1="67.5%" x2="90%" y2="75%"></line>
      <line class="fx-line" x1="30%" y1="95.5%" x2="42%" y2="93.8%"></line>
      <line class="fx-line" x1="42%" y1="93.8%" x2="55%" y2="96.4%"></line>
      <circle class="fx-node" cx="8%" cy="3.2%" r="1.5"></circle>
      <circle class="fx-node" cx="14%" cy="6.1%" r="2"></circle>
      <circle class="fx-node" cx="22%" cy="2.4%" r="1.5"></circle>
      <circle class="fx-node" cx="31%" cy="5.4%" r="2"></circle>
      <circle class="fx-node" cx="52%" cy="6%" r="1.5"></circle>
      <circle class="fx-node" cx="61%" cy="3.4%" r="2"></circle>
      <circle class="fx-node" cx="72%" cy="5.8%" r="1.5"></circle>
      <circle class="fx-node" cx="83%" cy="2.6%" r="2"></circle>
      <circle class="fx-node" cx="91%" cy="5.2%" r="1.5"></circle>
      <circle class="fx-node" cx="81%" cy="22%" r="1.5"></circle>
      <circle class="fx-node" cx="5%" cy="56%" r="1.5"></circle>
      <circle class="fx-node" cx="10%" cy="61.5%" r="2"></circle>
      <circle class="fx-node" cx="4.5%" cy="68%" r="1.5"></circle>
      <circle class="fx-node" cx="9.5%" cy="74.5%" r="2"></circle>
      <circle class="fx-node" cx="94%" cy="54%" r="1.5"></circle>
      <circle class="fx-node" cx="89.5%" cy="60.5%" r="2"></circle>
      <circle class="fx-node" cx="90%" cy="75%" r="1.5"></circle>
      <circle class="fx-node" cx="30%" cy="95.5%" r="1.5"></circle>
      <circle class="fx-node" cx="42%" cy="93.8%" r="2"></circle>
      <circle class="fx-node" cx="55%" cy="96.4%" r="1.5"></circle>
      <circle class="fx-node fx-amber" cx="40%" cy="2.8%" r="2"></circle>
      <circle class="fx-node fx-amber" cx="88%" cy="25.3%" r="2.5"></circle>
      <circle class="fx-node fx-amber" cx="95%" cy="67.5%" r="2"></circle>
      {
        /* dashed drift arc: an ellipse centered below the canvas so only its
          upper sweep is visible, arcing behind the portrait base */
      }
      <ellipse class="fx-arc" cx="50%" cy="118%" rx="52%" ry="42%"></ellipse>
    </g>
    <g class="fx-desk">
      {
        /* desktop split view: zigzag clusters across the top band, two loose
        dots in the column seam (no connecting stroke — a seam line reads as a
        rule), right-edge diagonal, bottom zigzag left of the portrait, drift
        arc behind the portrait's lower half */
      }
      <line class="fx-line" x1="7%" y1="14%" x2="11%" y2="6.5%" pathLength="1"></line>
      <line class="fx-line" x1="11%" y1="6.5%" x2="16%" y2="11%" pathLength="1"></line>
      <line class="fx-line" x1="16%" y1="11%" x2="21%" y2="5.5%" pathLength="1"></line>
      <line class="fx-line" x1="21%" y1="5.5%" x2="27%" y2="15.5%" pathLength="1"></line>
      <line class="fx-line" x1="38%" y1="7%" x2="44%" y2="12.5%" pathLength="1"></line>
      <line class="fx-line" x1="44%" y1="12.5%" x2="50%" y2="5.5%" pathLength="1"></line>
      <line class="fx-line" x1="58%" y1="15%" x2="63%" y2="9.5%" pathLength="1"></line>
      <line class="fx-line" x1="63%" y1="9.5%" x2="68%" y2="4.5%" pathLength="1"></line>
      <line class="fx-line" x1="74%" y1="12%" x2="81%" y2="7%" pathLength="1"></line>
      <line class="fx-line" x1="81%" y1="7%" x2="88%" y2="15.5%" pathLength="1"></line>
      <line class="fx-line" x1="88%" y1="15.5%" x2="93%" y2="5%" pathLength="1"></line>
      <line class="fx-line" x1="97%" y1="30%" x2="91.5%" y2="41%" pathLength="1"></line>
      <line class="fx-line" x1="7%" y1="86%" x2="13%" y2="92.5%" pathLength="1"></line>
      <line class="fx-line" x1="13%" y1="92.5%" x2="20%" y2="87.5%" pathLength="1"></line>
      <line class="fx-line" x1="20%" y1="87.5%" x2="28%" y2="93.5%" pathLength="1"></line>
      <line class="fx-line" x1="28%" y1="93.5%" x2="36%" y2="89%" pathLength="1"></line>
      <circle class="fx-node" cx="7%" cy="14%" r="2"></circle>
      <circle class="fx-node" cx="11%" cy="6.5%" r="1.5"></circle>
      <circle class="fx-node" cx="16%" cy="11%" r="2"></circle>
      <circle class="fx-node" cx="21%" cy="5.5%" r="1.5"></circle>
      <circle class="fx-node" cx="38%" cy="7%" r="1.5"></circle>
      <circle class="fx-node" cx="44%" cy="12.5%" r="2"></circle>
      <circle class="fx-node" cx="50%" cy="5.5%" r="1.5"></circle>
      <circle class="fx-node" cx="58%" cy="15%" r="1.5"></circle>
      <circle class="fx-node" cx="68%" cy="4.5%" r="2"></circle>
      <circle class="fx-node" cx="74%" cy="12%" r="1.5"></circle>
      <circle class="fx-node" cx="81%" cy="7%" r="2"></circle>
      <circle class="fx-node" cx="88%" cy="15.5%" r="1.5"></circle>
      <circle class="fx-node" cx="93%" cy="5%" r="2"></circle>
      <circle class="fx-node" cx="97%" cy="30%" r="1.5"></circle>
      <circle class="fx-node" cx="91.5%" cy="41%" r="2"></circle>
      <circle class="fx-node" cx="55.5%" cy="34%" r="1.5"></circle>
      <circle class="fx-node" cx="54.5%" cy="52%" r="2"></circle>
      <circle class="fx-node" cx="7%" cy="86%" r="1.5"></circle>
      <circle class="fx-node" cx="20%" cy="87.5%" r="2"></circle>
      <circle class="fx-node" cx="28%" cy="93.5%" r="1.5"></circle>
      <circle class="fx-node" cx="36%" cy="89%" r="2"></circle>
      <circle class="fx-node fx-amber" cx="27%" cy="15.5%" r="2"></circle>
      <circle class="fx-node fx-amber" cx="63%" cy="9.5%" r="2.5"></circle>
      <circle class="fx-node fx-amber" cx="13%" cy="92.5%" r="2"></circle>
      <ellipse class="fx-arc" cx="78%" cy="118%" rx="40%" ry="52%"></ellipse>
    </g>
  </svg>
  <Container width="wide">
    <div
      class="grid items-center gap-12 lg:min-h-[calc(100svh-64px)] lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:content-center lg:gap-16 xl:grid-cols-[minmax(0,1fr)_minmax(0,520px)] xl:gap-12"
    >
      <div>
        {
          /* xl type is sized by wrap math, not a display cap: the text column is
            664px (1232 container inner − 48 gap − 520 image col); at 60px/-0.04em
            Geist bold, "Full-stack developer for" = 653px — so the headline
            breaks once into the balanced 2-line block "Full-stack developer for"
            / "modern web products." (measured in-browser). NOTE the split
            "Full-stack developer" / "for modern web products." is impossible in
            pure CSS: line 2 (741px @64px) is WIDER than line 1 + "for" (697px),
            and the locked-copy test forbids a <br> inside the h1. Mobile slope
            is sized so "Full-stack developer" holds one line at 375px in Geist
            (signed-off 3-line wrap; ≤33.4px measured) */
        }
        <h1
          class="text-[clamp(28px,8.7vw,40px)] leading-tight font-bold tracking-tight text-balance sm:text-[clamp(40px,3vw+28px,72px)] lg:max-w-[14ch] lg:tracking-tighter xl:max-w-none xl:text-[60px]"
        >
          Full-stack developer for modern web products.
        </h1>
        <p
          class="text-text-secondary mt-6 max-w-[46ch] text-lg leading-normal text-pretty xl:text-xl"
        >
          I ship fast, polished work end-to-end — AI-augmented workflow, hand-finished by me.
        </p>
        <div class="mt-10 grid gap-3 sm:flex sm:flex-wrap sm:gap-4">
          <Button href="/contact?intent=project" size="xl" class="group">
            Start a project
            <span
              aria-hidden="true"
              class="ease-standard transition-transform duration-(--duration-instant) group-hover:translate-x-0.5"
              >→</span
            >
          </Button>
          <Button href="/work" variant="secondary" size="xl" class="group">
            View work
            <span
              aria-hidden="true"
              class="ease-standard transition-transform duration-(--duration-instant) group-hover:translate-x-0.5"
              >→</span
            >
          </Button>
        </div>
        <div class="mt-12 grid gap-2">
          <p class="text-text-secondary text-sm">
            <span
              aria-hidden="true"
              class="bg-accent mr-1.5 inline-block size-1.5 rounded-full align-middle"
            ></span>Available from August 2026 · Hvar, Croatia (CET).
          </p>
          <p class="text-text-muted font-mono text-xs text-balance sm:text-sm">
            React · Next.js · TypeScript · Node.js · Astro
          </p>
        </div>
      </div>
      <div
        class="hero-portrait-wrap relative w-full max-w-[420px] justify-self-center sm:max-w-[560px] lg:max-w-[460px] lg:justify-self-end xl:max-w-none"
      >
        <Picture
          src={headshot}
          formats={['avif']}
          fallbackFormat="webp"
          width={1440}
          widths={[460, 544, 720, 920, 1088, 1440]}
          sizes="(min-width: 1780px) 720px, (min-width: 1280px) 43vw, (min-width: 1024px) 460px, (min-width: 640px) 560px, min(100vw - 48px, 420px)"
          loading="eager"
          fetchpriority="high"
          alt="Kristijan Krešić — full-stack developer"
          class="hero-portrait relative h-auto w-full contrast-[1.04] saturate-[0.9]"
        />
      </div>
    </div>
  </Container>
</Section>

<style>
  /* One field language at every width (Friedman/WRITER pattern: the background
     has body, so the portrait dissolves INTO something instead of floating in
     a void). Below lg the layout stacks with the portrait last, so the lobes
     sit bottom-center behind it; at lg+ the mass moves low-right under the
     split-view portrait. Static — no reduced-motion concern. */
  .hero-field {
    background:
      radial-gradient(34% 16% at 50% 88%, var(--color-bg-elev-3), transparent 72%),
      radial-gradient(52% 26% at 42% 82%, var(--color-bg-elev-2), transparent 76%),
      radial-gradient(60% 30% at 58% 92%, var(--color-bg-elev-2), transparent 76%),
      radial-gradient(95% 45% at 50% 88%, var(--color-bg-elev-1), transparent 85%);
  }

  @media (min-width: 1024px) {
    .hero-field {
      /* Lobe centers are deliberately non-concentric — concentric rings read as
         a spotlight, offset lobes read as an organic form. Mass sits low-right
         because the portrait is bottom-anchored onto it. */
      background:
        radial-gradient(24% 30% at 73% 66%, var(--color-bg-elev-3), transparent 72%),
        radial-gradient(32% 42% at 84% 44%, var(--color-bg-elev-3), transparent 74%),
        radial-gradient(52% 64% at 65% 72%, var(--color-bg-elev-2), transparent 76%),
        radial-gradient(58% 72% at 84% 36%, var(--color-bg-elev-2), transparent 76%),
        radial-gradient(95% 120% at 72% 60%, var(--color-bg-elev-1), transparent 85%);
    }
  }

  /* ── Constellation backdrop ─────────────────────────────────────────────
     Texture, not decoration: everything sits in border tokens at low opacity;
     the FEW amber nodes stay far under the 5% accent viewport cap so the
     primary CTA remains the chroma peak. */
  .fx-line {
    stroke: var(--color-border-default);
    stroke-width: 1;
    opacity: 0.55;
  }

  .fx-node {
    fill: var(--color-border-strong);
    opacity: 0.6;
  }

  .fx-amber {
    fill: var(--color-accent);
    opacity: 0.45;
  }

  .fx-arc {
    fill: none;
    stroke: var(--color-border-default);
    stroke-width: 1;
    stroke-dasharray: 4 8;
    opacity: 0.5;
  }

  /* Reveal model — DESKTOP ONLY (fine pointer AND ≥1024px; the script gates
     on the same pair and bails before adding listeners elsewhere). Mobile and
     tablet keep the subtle static field below, no mask, no script work.
     Desktop: the whole field sits under a radial mask whose floor (0.08
     alpha) keeps it near-hidden at rest; the script grows --fx-r to 300px
     while the pointer is inside the hero, revealing the field around
     --mx/--my. Registered via @property so the radius TRANSITIONS — the
     reveal blooms in at the cursor and collapses on exit instead of popping.
     No JS → --fx-r stays 0 → the floor is all you see. Only mask
     position/size change per frame: no layout, no reflow. */
  .hero-fx {
    opacity: 0.35;
  }

  @property --fx-r {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  @media (pointer: fine) and (min-width: 1024px) {
    .hero-fx {
      opacity: 1;
      -webkit-mask-image: radial-gradient(
        var(--fx-r, 0px) circle at var(--mx, 50%) var(--my, 50%),
        rgb(0 0 0) 0%,
        rgb(0 0 0 / 0.55) 55%,
        rgb(0 0 0 / 0.08) 100%
      );
      mask-image: radial-gradient(
        var(--fx-r, 0px) circle at var(--mx, 50%) var(--my, 50%),
        rgb(0 0 0) 0%,
        rgb(0 0 0 / 0.55) 55%,
        rgb(0 0 0 / 0.08) 100%
      );
    }
  }

  /* Breakpoint composition gates: exactly ONE field variant renders per
     layout shape — stacked (sm), stacked-wide (tab), split (desk) — each
     authored against that layout's measured empty zones. */
  .fx-tab,
  .fx-desk {
    display: none;
  }

  @media (min-width: 768px) {
    .fx-sm {
      display: none;
    }

    .fx-tab {
      display: inline;
    }
  }

  @media (min-width: 1024px) {
    .fx-tab {
      display: none;
    }

    .fx-desk {
      display: inline;
    }
  }

  @media (min-width: 1920px) {
    /* ultra-wide: the percent spread thins the field, so nodes grow a hair to
       keep presence (geometry property; older engines fall back to the
       attribute radii — purely cosmetic) */
    .fx-node {
      r: 2.5px;
    }

    .fx-amber {
      r: 3px;
    }
  }

  /* Constellation draw-in — the reveal's character lives in the LINES. While
     the desktop script is active (.fx-js), every desk hairline hides behind
     its own dash (pathLength-normalized); when BOTH endpoints enter the
     reveal radius the script stamps .is-lit and the line DRAWS itself in,
     retracting again as the light moves on — the star map completes around
     the cursor. Nodes stay subtle: the mask's falloff is their only lift. */
  :global(.hero-section.fx-js) .fx-desk .fx-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(.hero-section.fx-js) .fx-desk .fx-line.is-lit {
    stroke-dashoffset: 0;
    opacity: 0.8;
  }

  /* Ambient motion + transitions, gated on user preference (global.css also
     hard-kills animation under reduce). The arc drifts its dashes; the amber
     twinkle is JS-randomized (WAAPI in the script below, self-gated on the
     same preference — no fixed CSS loop, so no two visits shimmer alike).
     The positional reveal mask is NOT in here — it isn't motion, it's
     position. */
  @media (prefers-reduced-motion: no-preference) {
    /* The bloom-in lives on the section: custom-property transitions animate
       on the element whose value changes (the script writes --fx-r inline
       here); the mask lookup downstream sees the interpolated radius. */
    :global(.hero-section) {
      transition: --fx-r var(--duration-slow) var(--ease-standard);
    }

    :global(.hero-section.fx-js) .fx-desk .fx-line {
      transition:
        stroke-dashoffset var(--duration-slow) var(--ease-standard),
        opacity var(--duration-normal) var(--ease-standard);
    }

    .fx-arc {
      animation: fx-drift 60s linear infinite;
    }
  }

  @keyframes fx-drift {
    to {
      stroke-dashoffset: 120;
    }
  }

  /* xl right-bleed: the portrait grows past its 520px grid column into the
     container padding + viewport gutter (24px at 1280 → capped 200px at 1780+),
     so it reads as anchored to the page edge instead of boxed in a column.
     overflow-x-clip on the Section guards the clip. */
  @media (min-width: 1280px) {
    .hero-portrait-wrap {
      /* A negative margin only SHIFTS a grid item — the explicit width is what
         actually widens it past its 520px track (verified by measurement).
         The extra width overflows leftward into the column gap; the h1 clears
         it by 48px at its widest line (measured). */
      width: calc(100% + min(200px, 24px + (100vw - 1280px) / 2));
      margin-right: calc(-1 * min(200px, 24px + (100vw - 1280px) / 2));
    }
  }

  /* Mobile keeps the signed-off bottom-only dissolve; at lg+ every edge
     dissolves into the field's mass — no visible cutout boundary on any side.
     Ellipse center sits at face height so the face stays in the solid zone. */
  .hero-portrait {
    -webkit-mask-image: linear-gradient(to bottom, black 72%, transparent 98%);
    mask-image: linear-gradient(to bottom, black 72%, transparent 98%);
  }

  @media (min-width: 1024px) {
    .hero-portrait {
      /* Two layers INTERSECTED (not the default additive compositing): a
         horizontal fade dissolves the shoulder/frame side edges, a vertical
         fade dissolves the torso bottom — both complete inside the frame, so
         no straight cut line survives on any edge. The top needs no fade: the
         no-bg PNG is transparent air above the head. A single radial can't do
         this — its bottom fade can't complete without also dimming the face. */
      -webkit-mask-image:
        linear-gradient(to right, transparent, black 14%, black 86%, transparent),
        linear-gradient(to bottom, black 62%, transparent 97%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to right, transparent, black 14%, black 86%, transparent),
        linear-gradient(to bottom, black 62%, transparent 97%);
      mask-composite: intersect;
    }
  }

  /* Amber glow deliberately absent for v1 (user decision 2026-07-19): the orb
     treatment never landed visually. DESIGN.md motion rule 8 (glow fades in one
     beat after copy) is deferred with it — revisit in the Phase 8 motion pass. */
</style>

{
  /* Cursor-proximity reveal (progressive enhancement per root CLAUDE.md
    Interactivity rules — script policy PR #61). Desktop only: bails before
    adding any listener unless the pointer is fine AND the viewport is ≥1024px
    (same gate as the reveal CSS). Tracks the pointer into --mx/--my with a
    light rAF ease so the spotlight trails the cursor, toggles --fx-r (the
    mask radius, transitioned in CSS) on enter/leave, and stamps .is-lit on
    each desk hairline whose BOTH endpoints sit inside the reveal radius — the
    CSS draw-in does the rest. Endpoint math is precomputed percentages ×
    the hero box: no per-frame DOM reads beyond one rect on pointer events,
    writes are custom props + class toggles (mask/stroke only — no layout).
    Under reduced motion the ease is skipped (direct positional write —
    position isn't motion; the draw-in transition is off via the CSS guard).
    Without JS the near-hidden static field stands complete. */
}
<script is:inline>
  (() => {
    const hero = document.querySelector('.hero-section');
    const desktop =
      matchMedia('(pointer: fine)').matches && matchMedia('(min-width: 1024px)').matches;
    if (!hero || !desktop) return;
    hero.classList.add('fx-js');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const R = 300;
    const lines = Array.from(hero.querySelectorAll('.fx-desk .fx-line'), (el) => ({
      el,
      lit: false,
      pts: [1, 2].map((n) => [
        parseFloat(el.getAttribute('x' + n)) / 100,
        parseFloat(el.getAttribute('y' + n)) / 100,
      ]),
    }));
    let w = 0;
    let h = 0;
    const measure = () => {
      const r = hero.getBoundingClientRect();
      w = r.width;
      h = r.height;
    };
    measure();
    addEventListener('resize', measure, { passive: true });
    let tx = 0;
    let ty = 0;
    let x = 0;
    let y = 0;
    let raf = 0;
    const frame = () => {
      const k = reduce.matches ? 1 : 0.22;
      x += (tx - x) * k;
      y += (ty - y) * k;
      hero.style.setProperty('--mx', x.toFixed(1) + 'px');
      hero.style.setProperty('--my', y.toFixed(1) + 'px');
      for (const l of lines) {
        const d0 = Math.hypot(l.pts[0][0] * w - x, l.pts[0][1] * h - y);
        const d1 = Math.hypot(l.pts[1][0] * w - x, l.pts[1][1] * h - y);
        const lit = d0 < R && d1 < R;
        if (lit !== l.lit) {
          // Directional draw: while still hidden, re-origin the line onto the
          // endpoint the cursor reached first (swap its x1y1/x2y2), so the
          // dash draws AWAY from the approach side — reversing the sweep
          // visibly reverses the trace. Attribute swap, nothing transitions.
          if (lit && d1 < d0) {
            const [a, b] = l.pts;
            l.pts = [b, a];
            const e = l.el;
            const sx = e.getAttribute('x1');
            const sy = e.getAttribute('y1');
            e.setAttribute('x1', e.getAttribute('x2'));
            e.setAttribute('y1', e.getAttribute('y2'));
            e.setAttribute('x2', sx);
            e.setAttribute('y2', sy);
          }
          l.lit = lit;
          l.el.classList.toggle('is-lit', lit);
        }
      }
      raf = Math.abs(tx - x) > 0.5 || Math.abs(ty - y) > 0.5 ? requestAnimationFrame(frame) : 0;
    };
    const track = (e) => {
      const r = hero.getBoundingClientRect();
      tx = e.clientX - r.left;
      ty = e.clientY - r.top;
    };
    hero.addEventListener('pointerenter', (e) => {
      track(e);
      x = tx;
      y = ty;
      hero.style.setProperty('--fx-r', R + 'px');
      frame();
    });
    hero.addEventListener(
      'pointermove',
      (e) => {
        track(e);
        if (!raf) raf = requestAnimationFrame(frame);
      },
      { passive: true },
    );
    hero.addEventListener('pointerleave', () => {
      // A trailing frame from pointermove would recompute `lit` from the last
      // inside coords and re-add .is-lit after this handler cleared it.
      cancelAnimationFrame(raf);
      raf = 0;
      hero.style.setProperty('--fx-r', '0px');
      for (const l of lines) {
        l.lit = false;
        l.el.classList.remove('is-lit');
      }
    });
    // Randomized amber twinkle, seeded per page load: a random accent dot
    // shimmers once at a random calm interval — ambient and rare, never the
    // same rhythm twice. WAAPI runs on rAF and bypasses the global.css
    // reduced-motion kill, so it self-gates (repo reduced-motion HARD RULE).
    if (!reduce.matches) {
      const ambers = hero.querySelectorAll('.fx-desk .fx-amber');
      const twinkle = () => {
        const el = ambers[Math.floor(Math.random() * ambers.length)];
        el.animate(
          { opacity: [0.45, 1, 0.45] },
          { duration: 1400 + Math.random() * 1200, easing: 'ease-in-out' },
        );
        setTimeout(twinkle, 2500 + Math.random() * 4500);
      };
      setTimeout(twinkle, 1000 + Math.random() * 2000);
    }
  })();
</script>
