---
import { Picture } from 'astro:assets';

import headshot from '@/assets/headshot-no-bg.png';
import Button from '@/components/primitives/Button.astro';
import Container from '@/components/primitives/Container.astro';
import Section from '@/components/primitives/Section.astro';
---

{
  /* overflow-x-clip: the glow bleeds past the portrait edges and would cause
    horizontal scroll at 375px otherwise (caught on the signed-off prototype) */
}
<Section class="overflow-x-clip lg:py-0">
  <Container>
    <div
      class="grid items-center gap-12 lg:min-h-[calc(100svh-64px)] lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:content-center lg:gap-16"
    >
      <div>
        {
          /* Fluid ramp, capped at 72px: --text-display's 96px cap pushed the
            recruiter-scan block below the 800px fold. Mobile slope is sized so
            "Full-stack developer" holds one line at 375px in Geist (signed-off
            3-line wrap; ≤33.4px measured) */
        }
        <h1
          class="text-[clamp(28px,8.7vw,40px)] leading-tight font-bold tracking-tight text-balance sm:text-[clamp(40px,3vw+28px,72px)] lg:max-w-[14ch] lg:tracking-tighter"
        >
          Full-stack developer for modern web products.
        </h1>
        <p class="text-text-secondary mt-6 max-w-[46ch] text-lg leading-normal text-pretty">
          I ship fast, polished work end-to-end — AI-augmented workflow, hand-finished by me.
        </p>
        <div class="mt-10 grid gap-3 sm:flex sm:flex-wrap sm:gap-4">
          <Button href="/contact?intent=project" size="xl" class="group">
            Start a project
            <span
              aria-hidden="true"
              class="ease-standard transition-transform duration-(--duration-instant) group-hover:translate-x-0.5"
              >→</span
            >
          </Button>
          <Button href="/work" variant="secondary" size="xl" class="group">
            View work
            <span
              aria-hidden="true"
              class="ease-standard transition-transform duration-(--duration-instant) group-hover:translate-x-0.5"
              >→</span
            >
          </Button>
        </div>
        <div class="mt-12 grid gap-2">
          <p class="text-text-muted text-sm">Available from August 2026 · Hvar, Croatia (CET).</p>
          <p class="text-text-muted font-mono text-xs text-balance sm:text-sm">
            React · Next.js · TypeScript · Node.js · Astro
          </p>
        </div>
      </div>
      <div
        class="relative w-full max-w-[420px] justify-self-center lg:max-w-[460px] lg:justify-self-end"
      >
        <div class="hero-glow" aria-hidden="true"></div>
        <Picture
          src={headshot}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[460, 920, 1380]}
          sizes="(min-width: 1024px) 460px, min(100vw - 48px, 420px)"
          loading="eager"
          fetchpriority="high"
          alt="Kristijan Krešić — full-stack developer"
          class="relative h-auto w-full [mask-image:linear-gradient(to_bottom,black_72%,transparent_98%)] contrast-[1.04] saturate-[0.9]"
        />
      </div>
    </div>
  </Container>
</Section>

<style>
  /* Radial amber glow behind the head — cutout + amber glow treatment.
     Keyframes + reduced-motion gate are why this isn't a utility class. */
  .hero-glow {
    position: absolute;
    inset: -12% -8% 0;
    background: radial-gradient(55% 50% at 50% 38%, var(--color-accent-glow), transparent 70%);
    pointer-events: none;
  }

  /* Copy readable first, warmth one beat later (DESIGN.md motion psychology);
     reduced-motion users get the glow immediately with no animation */
  @media (prefers-reduced-motion: no-preference) {
    .hero-glow {
      opacity: 0;
      animation: hero-glow-in var(--duration-deliberate) var(--ease-out) var(--duration-normal)
        forwards;
    }

    @keyframes hero-glow-in {
      to {
        opacity: 1;
      }
    }
  }
</style>
