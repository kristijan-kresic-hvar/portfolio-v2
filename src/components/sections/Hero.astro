---
import { Picture } from 'astro:assets';

import headshot from '@/assets/headshot-no-bg.png';
import Button from '@/components/primitives/Button.astro';
import Container from '@/components/primitives/Container.astro';
import Section from '@/components/primitives/Section.astro';
---

{
  /* overflow-x-clip: the depth field + the portrait's xl right-bleed extend past
    the container and would cause horizontal scroll otherwise */
}
{
  /* lg:py-0! — needs the important modifier to beat Section's own lg:py-24
    (same specificity, later in the generated CSS); the grid's min-h owns the
    full-viewport height at lg instead */
}
<Section class="hero-section relative isolate overflow-x-clip lg:py-0!">
  <div class="hero-field absolute inset-0 -z-10" aria-hidden="true"></div>
  {
    /* Constellation backdrop (KKD-34, pattern adapted from designwithintent.ai):
      a sparse dot-node field connected by hairlines + a dashed drift arc, plus a
      few blueprint frame rules. Because the hero's layout changes shape per
      breakpoint (stacked / stacked-wide / split), the field is authored THREE
      times — .fx-sm / .fx-tab / .fx-desk — each placed against the measured
      empty zones of that layout (coordinates probed in-browser at 375/768/1280),
      so every width is deliberately composed, never merely scaled. Node radii
      stay in px so dots never balloon. Colors are tokens-only via the scoped
      stylesheet; interactivity is pure CSS (section hover + :has() on the
      primary CTA). Zero JS. */
  }
  <svg
    class="hero-fx pointer-events-none absolute inset-0 -z-10 h-full w-full"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
  >
    <g class="fx-sm">
      {
        /* mobile: strip above the h1, the h1's ragged right edge, the gap above
        the portrait, and the bottom dissolve zone */
      }
      <line class="fx-rule" x1="0%" y1="2.6%" x2="100%" y2="2.6%"></line>
      <line class="fx-tick" x1="6.4%" y1="1.4%" x2="6.4%" y2="3.8%"></line>
      <line class="fx-tick" x1="93.6%" y1="1.4%" x2="93.6%" y2="3.8%"></line>
      <line class="fx-line fx-line-hot" x1="20%" y1="1.6%" x2="30%" y2="3.4%"></line>
      <line class="fx-line" x1="42%" y1="3.6%" x2="54%" y2="1.8%"></line>
      <line class="fx-line" x1="68%" y1="15.5%" x2="80%" y2="13.6%"></line>
      <line class="fx-line fx-line-hot" x1="12%" y1="62.5%" x2="24%" y2="61%"></line>
      <line class="fx-line" x1="58%" y1="97%" x2="72%" y2="95.5%"></line>
      <circle class="fx-node" cx="20%" cy="1.6%" r="1.5"></circle>
      <circle class="fx-node" cx="42%" cy="3.6%" r="2"></circle>
      <circle class="fx-node" cx="54%" cy="1.8%" r="1.5"></circle>
      <circle class="fx-node" cx="68%" cy="15.5%" r="1.5"></circle>
      <circle class="fx-node" cx="80%" cy="13.6%" r="2"></circle>
      <circle class="fx-node" cx="12%" cy="62.5%" r="1.5"></circle>
      <circle class="fx-node" cx="58%" cy="97%" r="1.5"></circle>
      <circle class="fx-node" cx="72%" cy="95.5%" r="2"></circle>
      <circle class="fx-node fx-amber" cx="30%" cy="3.4%" r="2" style="animation-delay: -1.4s"
      ></circle>
      <circle class="fx-node fx-amber" cx="24%" cy="61%" r="2" style="animation-delay: -3.1s"
      ></circle>
    </g>
    <g class="fx-tab">
      {
        /* tablet: top strip, the subheadline's right gap, both portrait side
        gutters, bottom dissolve + drift arc behind the portrait base */
      }
      <line class="fx-rule" x1="0%" y1="4%" x2="100%" y2="4%"></line>
      <line class="fx-tick" x1="3.1%" y1="2.6%" x2="3.1%" y2="5.4%"></line>
      <line class="fx-tick" x1="96.9%" y1="2.6%" x2="96.9%" y2="5.4%"></line>
      <line class="fx-line" x1="10%" y1="2.6%" x2="20%" y2="5.6%"></line>
      <line class="fx-line fx-line-hot" x1="34%" y1="5.8%" x2="44%" y2="2.4%"></line>
      <line class="fx-line" x1="58%" y1="5.4%" x2="70%" y2="2.8%"></line>
      <line class="fx-line fx-line-hot" x1="80%" y1="22.5%" x2="88%" y2="25%"></line>
      <line class="fx-line" x1="6%" y1="58%" x2="4%" y2="70%"></line>
      <line class="fx-line" x1="4%" y1="70%" x2="8%" y2="80%"></line>
      <line class="fx-line" x1="94%" y1="55%" x2="96%" y2="68%"></line>
      <line class="fx-line" x1="96%" y1="68%" x2="92%" y2="82%"></line>
      <line class="fx-line" x1="30%" y1="96%" x2="44%" y2="94%"></line>
      <circle class="fx-node" cx="10%" cy="2.6%" r="1.5"></circle>
      <circle class="fx-node" cx="20%" cy="5.6%" r="2"></circle>
      <circle class="fx-node" cx="34%" cy="5.8%" r="2"></circle>
      <circle class="fx-node" cx="58%" cy="5.4%" r="1.5"></circle>
      <circle class="fx-node" cx="70%" cy="2.8%" r="2"></circle>
      <circle class="fx-node" cx="80%" cy="22.5%" r="1.5"></circle>
      <circle class="fx-node" cx="6%" cy="58%" r="1.5"></circle>
      <circle class="fx-node" cx="4%" cy="70%" r="2"></circle>
      <circle class="fx-node" cx="8%" cy="80%" r="1.5"></circle>
      <circle class="fx-node" cx="94%" cy="55%" r="1.5"></circle>
      <circle class="fx-node" cx="96%" cy="68%" r="2"></circle>
      <circle class="fx-node" cx="92%" cy="82%" r="1.5"></circle>
      <circle class="fx-node" cx="30%" cy="96%" r="1.5"></circle>
      <circle class="fx-node" cx="44%" cy="94%" r="2"></circle>
      <circle class="fx-node fx-amber" cx="44%" cy="2.4%" r="2" style="animation-delay: -0.6s"
      ></circle>
      <circle class="fx-node fx-amber" cx="88%" cy="25%" r="2.5" style="animation-delay: -2.2s"
      ></circle>
      <circle class="fx-node fx-amber" cx="92%" cy="82%" r="2" style="animation-delay: -4.4s"
      ></circle>
      {
        /* dashed drift arc: an ellipse centered below the canvas so only its
          upper sweep is visible, arcing behind the portrait base */
      }
      <ellipse class="fx-arc" cx="50%" cy="118%" rx="52%" ry="42%"></ellipse>
    </g>
    <g class="fx-desk">
      {
        /* desktop split view: top band above both columns, column-seam chain,
        right-edge pair, bottom band left of the portrait, drift arc behind the
        portrait's lower half */
      }
      <line class="fx-rule" x1="0%" y1="6%" x2="100%" y2="6%"></line>
      <line class="fx-tick" x1="4%" y1="4.2%" x2="4%" y2="7.8%"></line>
      <line class="fx-tick" x1="96%" y1="4.2%" x2="96%" y2="7.8%"></line>
      <line class="fx-rule" x1="54.8%" y1="13%" x2="54.8%" y2="87%"></line>
      <line class="fx-tick fx-tick-amber" x1="54.8%" y1="4.8%" x2="54.8%" y2="7.2%"></line>
      <line class="fx-line" x1="6%" y1="11%" x2="13%" y2="7.5%"></line>
      <line class="fx-line" x1="13%" y1="7.5%" x2="22%" y2="12%"></line>
      <line class="fx-line" x1="34%" y1="8%" x2="46%" y2="11%"></line>
      <line class="fx-line fx-line-hot" x1="58%" y1="7.5%" x2="66%" y2="12%"></line>
      <line class="fx-line" x1="74%" y1="9%" x2="86%" y2="13%"></line>
      <line class="fx-line" x1="86%" y1="13%" x2="93%" y2="7.5%"></line>
      <line class="fx-line" x1="55%" y1="32%" x2="54.4%" y2="46%"></line>
      <line class="fx-line" x1="54.4%" y1="46%" x2="55.2%" y2="60%"></line>
      <line class="fx-line" x1="96%" y1="30%" x2="97%" y2="46%"></line>
      <line class="fx-line fx-line-hot" x1="8%" y1="88%" x2="16%" y2="93%"></line>
      <line class="fx-line" x1="16%" y1="93%" x2="30%" y2="90%"></line>
      <line class="fx-line" x1="30%" y1="90%" x2="42%" y2="93%"></line>
      <circle class="fx-node" cx="6%" cy="11%" r="2"></circle>
      <circle class="fx-node" cx="13%" cy="7.5%" r="1.5"></circle>
      <circle class="fx-node" cx="22%" cy="12%" r="2"></circle>
      <circle class="fx-node" cx="34%" cy="8%" r="1.5"></circle>
      <circle class="fx-node" cx="46%" cy="11%" r="2"></circle>
      <circle class="fx-node" cx="58%" cy="7.5%" r="1.5"></circle>
      <circle class="fx-node" cx="74%" cy="9%" r="2"></circle>
      <circle class="fx-node" cx="86%" cy="13%" r="1.5"></circle>
      <circle class="fx-node" cx="93%" cy="7.5%" r="2"></circle>
      <circle class="fx-node" cx="55%" cy="32%" r="1.5"></circle>
      <circle class="fx-node" cx="54.4%" cy="46%" r="2"></circle>
      <circle class="fx-node" cx="55.2%" cy="60%" r="1.5"></circle>
      <circle class="fx-node" cx="96%" cy="30%" r="1.5"></circle>
      <circle class="fx-node" cx="97%" cy="46%" r="2"></circle>
      <circle class="fx-node" cx="8%" cy="88%" r="1.5"></circle>
      <circle class="fx-node" cx="30%" cy="90%" r="2"></circle>
      <circle class="fx-node" cx="42%" cy="93%" r="1.5"></circle>
      <circle class="fx-node fx-amber" cx="66%" cy="12%" r="2.5" style="animation-delay: -1.4s"
      ></circle>
      <circle class="fx-node fx-amber" cx="28%" cy="16%" r="2" style="animation-delay: -0.6s"
      ></circle>
      <circle class="fx-node fx-amber" cx="16%" cy="93%" r="2" style="animation-delay: -3.1s"
      ></circle>
      <ellipse class="fx-arc" cx="78%" cy="118%" rx="40%" ry="52%"></ellipse>
    </g>
  </svg>
  <Container width="wide">
    <div
      class="grid items-center gap-12 lg:min-h-[calc(100svh-64px)] lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:content-center lg:gap-16 xl:grid-cols-[minmax(0,1fr)_minmax(0,520px)] xl:gap-12"
    >
      <div>
        {
          /* xl type is sized by wrap math, not a display cap: the text column is
            664px (1232 container inner − 48 gap − 520 image col); at 60px/-0.04em
            Geist bold, "Full-stack developer for" = 653px — so the headline
            breaks once into the balanced 2-line block "Full-stack developer for"
            / "modern web products." (measured in-browser). NOTE the split
            "Full-stack developer" / "for modern web products." is impossible in
            pure CSS: line 2 (741px @64px) is WIDER than line 1 + "for" (697px),
            and the locked-copy test forbids a <br> inside the h1. Mobile slope
            is sized so "Full-stack developer" holds one line at 375px in Geist
            (signed-off 3-line wrap; ≤33.4px measured) */
        }
        <h1
          class="text-[clamp(28px,8.7vw,40px)] leading-tight font-bold tracking-tight text-balance sm:text-[clamp(40px,3vw+28px,72px)] lg:max-w-[14ch] lg:tracking-tighter xl:max-w-none xl:text-[60px]"
        >
          Full-stack developer for modern web products.
        </h1>
        <p
          class="text-text-secondary mt-6 max-w-[46ch] text-lg leading-normal text-pretty xl:text-xl"
        >
          I ship fast, polished work end-to-end — AI-augmented workflow, hand-finished by me.
        </p>
        <div class="mt-10 grid gap-3 sm:flex sm:flex-wrap sm:gap-4">
          <Button href="/contact?intent=project" size="xl" class="group">
            Start a project
            <span
              aria-hidden="true"
              class="ease-standard transition-transform duration-(--duration-instant) group-hover:translate-x-0.5"
              >→</span
            >
          </Button>
          <Button href="/work" variant="secondary" size="xl" class="group">
            View work
            <span
              aria-hidden="true"
              class="ease-standard transition-transform duration-(--duration-instant) group-hover:translate-x-0.5"
              >→</span
            >
          </Button>
        </div>
        <div class="mt-12 grid gap-2">
          <p class="text-text-secondary text-sm">
            <span
              aria-hidden="true"
              class="bg-accent mr-1.5 inline-block size-1.5 rounded-full align-middle"
            ></span>Available from August 2026 · Hvar, Croatia (CET).
          </p>
          <p class="text-text-muted font-mono text-xs text-balance sm:text-sm">
            React · Next.js · TypeScript · Node.js · Astro
          </p>
        </div>
      </div>
      <div
        class="hero-portrait-wrap relative w-full max-w-[420px] justify-self-center sm:max-w-[560px] lg:max-w-[460px] lg:justify-self-end xl:max-w-none"
      >
        <Picture
          src={headshot}
          formats={['avif']}
          fallbackFormat="webp"
          width={1440}
          widths={[460, 544, 720, 920, 1088, 1440]}
          sizes="(min-width: 1780px) 720px, (min-width: 1280px) 43vw, (min-width: 1024px) 460px, (min-width: 640px) 560px, min(100vw - 48px, 420px)"
          loading="eager"
          fetchpriority="high"
          alt="Kristijan Krešić — full-stack developer"
          class="hero-portrait relative h-auto w-full contrast-[1.04] saturate-[0.9]"
        />
      </div>
    </div>
  </Container>
</Section>

<style>
  /* One field language at every width (Friedman/WRITER pattern: the background
     has body, so the portrait dissolves INTO something instead of floating in
     a void). Below lg the layout stacks with the portrait last, so the lobes
     sit bottom-center behind it; at lg+ the mass moves low-right under the
     split-view portrait. Static — no reduced-motion concern. */
  .hero-field {
    background:
      radial-gradient(34% 16% at 50% 88%, var(--color-bg-elev-3), transparent 72%),
      radial-gradient(52% 26% at 42% 82%, var(--color-bg-elev-2), transparent 76%),
      radial-gradient(60% 30% at 58% 92%, var(--color-bg-elev-2), transparent 76%),
      radial-gradient(95% 45% at 50% 88%, var(--color-bg-elev-1), transparent 85%);
  }

  @media (min-width: 1024px) {
    .hero-field {
      /* Lobe centers are deliberately non-concentric — concentric rings read as
         a spotlight, offset lobes read as an organic form. Mass sits low-right
         because the portrait is bottom-anchored onto it. */
      background:
        radial-gradient(24% 30% at 73% 66%, var(--color-bg-elev-3), transparent 72%),
        radial-gradient(32% 42% at 84% 44%, var(--color-bg-elev-3), transparent 74%),
        radial-gradient(52% 64% at 65% 72%, var(--color-bg-elev-2), transparent 76%),
        radial-gradient(58% 72% at 84% 36%, var(--color-bg-elev-2), transparent 76%),
        radial-gradient(95% 120% at 72% 60%, var(--color-bg-elev-1), transparent 85%);
    }
  }

  /* ── Constellation backdrop ─────────────────────────────────────────────
     Texture, not decoration: everything sits in border tokens at low opacity;
     the FEW amber nodes stay far under the 5% accent viewport cap so the
     primary CTA remains the chroma peak. */
  .fx-line {
    stroke: var(--color-border-default);
    stroke-width: 1;
    opacity: 0.55;
    transition:
      opacity var(--duration-normal) var(--ease-standard),
      stroke var(--duration-normal) var(--ease-standard);
  }

  .fx-node {
    fill: var(--color-border-strong);
    opacity: 0.6;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity var(--duration-normal) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .fx-amber {
    fill: var(--color-accent);
    opacity: 0.45;
  }

  .fx-arc {
    fill: none;
    stroke: var(--color-border-default);
    stroke-width: 1;
    stroke-dasharray: 4 8;
    opacity: 0.5;
  }

  .fx-rule {
    stroke: var(--color-border-subtle);
    stroke-width: 1;
  }

  .fx-tick {
    stroke: var(--color-border-default);
    stroke-width: 1;
    opacity: 0.8;
  }

  .fx-tick-amber {
    stroke: var(--color-accent);
    opacity: 0.6;
  }

  /* Breakpoint composition gates: exactly ONE field variant renders per
     layout shape — stacked (sm), stacked-wide (tab), split (desk) — each
     authored against that layout's measured empty zones. */
  .fx-tab,
  .fx-desk {
    display: none;
  }

  @media (min-width: 768px) {
    .fx-sm {
      display: none;
    }

    .fx-tab {
      display: inline;
    }
  }

  @media (min-width: 1024px) {
    .fx-tab {
      display: none;
    }

    .fx-desk {
      display: inline;
    }
  }

  @media (min-width: 1920px) {
    /* ultra-wide: the percent spread thins the field, so nodes grow a hair to
       keep presence (geometry property; older engines fall back to the
       attribute radii — purely cosmetic) */
    .fx-node {
      r: 2.5px;
    }

    .fx-amber {
      r: 3px;
    }
  }

  /* CSS-only interactivity. Hovering anywhere in the hero warms the whole
     field a notch; hovering the primary CTA (via :has(), no JS) lights the
     amber nodes + their adjacent hairlines — the field answers the CTA. */
  :global(.hero-section:hover) .fx-line {
    opacity: 0.8;
  }

  :global(.hero-section:hover) .fx-node {
    opacity: 0.85;
  }

  :global(.hero-section:hover) .fx-amber {
    opacity: 0.7;
  }

  :global(.hero-section:has(a[href='/contact?intent=project']:hover)) .fx-amber {
    opacity: 1;
    transform: scale(1.5);
  }

  :global(.hero-section:has(a[href='/contact?intent=project']:hover)) .fx-line-hot {
    stroke: var(--color-accent);
    opacity: 0.5;
  }

  /* Ambient motion, gated on user preference (global.css also hard-kills
     animation under reduce). The pulse animates fill-opacity so it never
     fights the hover opacity transitions above; the arc drifts its dashes. */
  @media (prefers-reduced-motion: no-preference) {
    .fx-amber {
      animation: fx-pulse 6s var(--ease-standard) infinite;
    }

    .fx-arc {
      animation: fx-drift 60s linear infinite;
    }
  }

  @keyframes fx-pulse {
    0%,
    100% {
      fill-opacity: 0.5;
    }

    50% {
      fill-opacity: 1;
    }
  }

  @keyframes fx-drift {
    to {
      stroke-dashoffset: 120;
    }
  }

  /* xl right-bleed: the portrait grows past its 520px grid column into the
     container padding + viewport gutter (24px at 1280 → capped 200px at 1780+),
     so it reads as anchored to the page edge instead of boxed in a column.
     overflow-x-clip on the Section guards the clip. */
  @media (min-width: 1280px) {
    .hero-portrait-wrap {
      /* A negative margin only SHIFTS a grid item — the explicit width is what
         actually widens it past its 520px track (verified by measurement).
         The extra width overflows leftward into the column gap; the h1 clears
         it by 48px at its widest line (measured). */
      width: calc(100% + min(200px, 24px + (100vw - 1280px) / 2));
      margin-right: calc(-1 * min(200px, 24px + (100vw - 1280px) / 2));
    }
  }

  /* Mobile keeps the signed-off bottom-only dissolve; at lg+ every edge
     dissolves into the field's mass — no visible cutout boundary on any side.
     Ellipse center sits at face height so the face stays in the solid zone. */
  .hero-portrait {
    -webkit-mask-image: linear-gradient(to bottom, black 72%, transparent 98%);
    mask-image: linear-gradient(to bottom, black 72%, transparent 98%);
  }

  @media (min-width: 1024px) {
    .hero-portrait {
      /* Two layers INTERSECTED (not the default additive compositing): a
         horizontal fade dissolves the shoulder/frame side edges, a vertical
         fade dissolves the torso bottom — both complete inside the frame, so
         no straight cut line survives on any edge. The top needs no fade: the
         no-bg PNG is transparent air above the head. A single radial can't do
         this — its bottom fade can't complete without also dimming the face. */
      -webkit-mask-image:
        linear-gradient(to right, transparent, black 14%, black 86%, transparent),
        linear-gradient(to bottom, black 62%, transparent 97%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to right, transparent, black 14%, black 86%, transparent),
        linear-gradient(to bottom, black 62%, transparent 97%);
      mask-composite: intersect;
    }
  }

  /* Amber glow deliberately absent for v1 (user decision 2026-07-19): the orb
     treatment never landed visually. DESIGN.md motion rule 8 (glow fades in one
     beat after copy) is deferred with it — revisit in the Phase 8 motion pass. */
</style>
