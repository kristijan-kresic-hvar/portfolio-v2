---
import Chip from '@/components/primitives/Chip.astro';
import Container from '@/components/primitives/Container.astro';
import Section from '@/components/primitives/Section.astro';

// Recruiter-search keywords (KKD-26 locked list) — verbatim strings matter.
// Keep "React.js" not "React"; don't normalize. PostgreSQL confirmed from the
// Agilno project record (Naitur, Vetster); Prisma unconfirmed, deliberately out.
// The AI group sits in an accent-tinted panel: it's the positioning
// differentiator, and the tint links it visually to WhatIDo's boundary cell.
const groups = [
  {
    label: 'Frontend',
    terms: [
      'Next.js',
      'React.js',
      'Vue.js',
      'TypeScript',
      'JavaScript',
      'Redux',
      'Tailwind CSS',
      'Sass',
      'HTML5',
      'CSS3',
    ],
  },
  {
    label: 'Backend',
    terms: ['Node.js', 'PHP', 'REST APIs', 'OOP', 'PostgreSQL'],
  },
  {
    label: 'Tools',
    terms: ['Git', 'GitHub', 'CLI/Terminal', 'Vercel'],
  },
];

const aiGroup = {
  label: 'AI-augmented workflow',
  terms: ['Claude', 'GPT', 'Codex', 'Cursor', 'Agentic coding'],
};
---

<Section aria-labelledby="tech-stack-heading">
  <Container width="wide">
    <h2
      id="tech-stack-heading"
      class="text-text-primary text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl"
    >
      Tech stack
    </h2>
    <dl class="mt-10 lg:mt-12">
      {
        groups.map((group) => (
          <div class="border-border-subtle grid gap-3 border-t py-6 sm:grid-cols-[11rem_1fr] sm:gap-6 sm:py-7">
            <dt class="text-text-secondary font-mono text-sm sm:pt-1">{group.label}</dt>
            <dd class="flex flex-wrap gap-2">
              {group.terms.map((term) => (
                <Chip>{term}</Chip>
              ))}
            </dd>
          </div>
        ))
      }
      <div
        class="border-border-default bg-accent-subtle mt-6 grid gap-3 rounded-lg border p-6 sm:grid-cols-[11rem_1fr] sm:gap-6 sm:p-7"
      >
        <dt class="text-accent-text font-mono text-sm sm:pt-1">{aiGroup.label}</dt>
        <dd class="flex flex-wrap gap-2">
          {aiGroup.terms.map((term) => <Chip>{term}</Chip>)}
        </dd>
      </div>
    </dl>
  </Container>
</Section>
