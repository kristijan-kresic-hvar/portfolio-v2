---
import Container from '@/components/primitives/Container.astro';
import Link from '@/components/primitives/Link.astro';
import Section from '@/components/primitives/Section.astro';

// Step lines are capped at 12 words (research L-4) — enforced by sections.test.ts
// via data-step-line. AI-boundary copy mirrors the locked line in PRODUCT.md.
const steps = [
  {
    label: 'Discovery',
    line: 'A paid week to scope the work before anything is built.',
  },
  {
    label: 'Build',
    line: 'Weekly written updates. You always know where the work stands.',
  },
  {
    label: 'Support',
    line: "30 days of post-ship support. I stay until it's stable.",
  },
];

const narrative =
  'AI makes me faster. It scaffolds code, drafts research, and explores options in minutes, not afternoons. Every line still gets read, tested, and owned by me before it ships.';

const boundary =
  'The boundary is explicit. AI for codegen scaffolds and research drafts. Not for architecture decisions, security review, or anything that ships under my name.';
---

<Section aria-labelledby="how-i-work-heading">
  <Container width="reading">
    <h2 id="how-i-work-heading" class="text-text-primary text-3xl font-bold tracking-tight">
      How I work
    </h2>

    <p class="text-text-secondary mt-8 text-pretty">{narrative}</p>
    <p class="text-text-secondary mt-4 text-pretty">{boundary}</p>

    <ol role="list" class="mt-12 grid gap-8 sm:grid-cols-3 sm:gap-6">
      {
        steps.map((step, index) => (
          <li class="border-border-subtle border-t pt-4">
            <h3 class="text-text-primary text-sm font-semibold">
              <span class="text-text-muted mr-2 font-mono text-xs font-normal" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              {step.label}
            </h3>
            <p class="text-text-secondary mt-2 text-sm text-pretty" data-step-line>
              {step.line}
            </p>
          </li>
        ))
      }
    </ol>

    <p class="text-text-muted mt-12 text-sm text-pretty">
      The process itself is public. Linear tickets written as executable specs drive AI agents
      through worktree, TDD, and PR, with an adversarial AI review on every pull request. I gate
      every merge. See <Link
        href="https://github.com/kristijan-kresic-hvar/linear-pipeline-kit"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs">linear-pipeline-kit</Link
      > and <Link
        href="https://github.com/kristijan-kresic-hvar/ai-review-kit"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs">ai-review-kit</Link
      >.
    </p>
  </Container>
</Section>
