---
import type { IconName } from '@/components/icons/Icon.astro';
import Icon from '@/components/icons/Icon.astro';
import Container from '@/components/primitives/Container.astro';
import Link from '@/components/primitives/Link.astro';
import Section from '@/components/primitives/Section.astro';

// Step lines are capped at 12 words (research L-4) — enforced by sections.test.ts
// via data-step-line. AI-boundary copy mirrors the locked line in PRODUCT.md.
const steps: { label: string; line: string; icon: IconName }[] = [
  {
    label: 'Discovery',
    line: 'A paid week to scope the work before anything is built.',
    icon: 'compass',
  },
  {
    label: 'Build',
    line: 'Weekly written updates. You always know where the work stands.',
    icon: 'code',
  },
  {
    label: 'Support',
    line: "30 days of post-ship support. I stay until it's stable.",
    icon: 'shield',
  },
];

const narrative =
  'AI makes me faster. It scaffolds code, drafts research, and explores options in minutes, not afternoons. Every line still gets read, tested, and owned by me before it ships.';

const boundary =
  'The boundary is explicit. AI for codegen scaffolds and research drafts. Not for architecture decisions, security review, or anything that ships under my name.';
---

{
  /* Asymmetric split: narrative + boundary callout left, process rail with
    oversized amber numerals right — the page's one numbered sequence (it IS
    a sequence). Elevated band breaks the base-bg rhythm. */
}
<Section aria-labelledby="how-i-work-heading" class="border-border-subtle bg-bg-elev-1 border-y">
  <Container width="wide">
    <div class="lg:grid lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2
          id="how-i-work-heading"
          class="text-text-primary text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl"
        >
          How I work
        </h2>

        <p class="text-text-secondary mt-8 text-pretty">{narrative}</p>

        <div class="border-border-default bg-bg-base mt-6 rounded-lg border p-6">
          <Icon name="terminal" class="text-accent size-5" />
          <p class="text-text-secondary mt-3 text-sm text-pretty">{boundary}</p>
        </div>

      </div>

      <ol role="list" class="mt-12 lg:col-span-7 lg:mt-0">
        {
          steps.map((step, index) => (
            <li class="border-border-default grid grid-cols-[minmax(4.5rem,auto)_1fr] items-start gap-6 border-t py-8 first:border-t-0 first:pt-0 sm:grid-cols-[minmax(7rem,auto)_1fr] sm:py-10 lg:first:pt-2">
              <span
                aria-hidden="true"
                class="text-accent text-5xl leading-none font-bold tracking-tighter sm:text-7xl"
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-text-primary flex items-center gap-2.5 text-lg font-semibold sm:text-xl">
                  <Icon name={step.icon} class="text-text-secondary size-5" />
                  {step.label}
                </h3>
                <p class="text-text-secondary mt-2 text-pretty" data-step-line>
                  {step.line}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</Section>
