---
import type { IconName } from '@/components/icons/Icon.astro';
import Icon from '@/components/icons/Icon.astro';
import Container from '@/components/primitives/Container.astro';
import Section from '@/components/primitives/Section.astro';

// AI-boundary line mirrors the locked copy in PRODUCT.md — keep them in sync.
// The AI cell carries the accent tint: it answers the "did you actually do
// this?" objection, so it gets the section's one dose of salience.
const capabilities: { title: string; line: string; icon: IconName; tinted?: boolean }[] = [
  {
    title: 'Full-stack web',
    line: 'Frontends, APIs, and the data layer behind them — built end-to-end by one owner, first commit to production.',
    icon: 'layers',
  },
  {
    title: 'Product engineering',
    line: 'Features scoped against the product goal, not the ticket. Trade-offs named before they are built.',
    icon: 'route',
  },
  {
    title: 'AI-augmented workflow',
    line: 'AI for codegen scaffolds and research drafts. Not for architecture decisions, security review, or anything that ships under my name.',
    icon: 'terminal',
    tinted: true,
  },
  {
    title: 'Performance & UX polish',
    line: 'Fast pages, stable layouts, keyboard-clean interactions. The last 10% gets finished, not skipped.',
    icon: 'gauge',
  },
];
---

{/* Ruled 2×2 grid, no card boxes — hairlines and spacing carry the structure. */}
<Section aria-labelledby="what-i-do-heading">
  <Container width="wide">
    <div class="lg:grid lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <h2
          id="what-i-do-heading"
          class="text-text-primary text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl"
        >
          What I do
        </h2>
        <p class="text-text-body mt-4 max-w-[24ch] text-lg text-pretty">
          Four lanes. One owner, end to end.
        </p>
      </div>
      <ul role="list" class="mt-10 grid sm:grid-cols-2 lg:col-span-8 lg:mt-0">
        {
          capabilities.map((capability, index) => (
            <li
              class:list={[
                'border-border-subtle border-t p-6 sm:p-8',
                index % 2 === 1 && 'sm:border-l',
                capability.tinted && 'bg-accent-subtle',
              ]}
            >
              <Icon
                name={capability.icon}
                class:list={['size-6', capability.tinted ? 'text-accent' : 'text-text-secondary']}
              />
              <h3 class="text-text-primary mt-4 text-lg font-semibold sm:text-xl">
                {capability.title}
              </h3>
              <p class="text-text-secondary mt-2 text-sm text-pretty sm:text-base">
                {capability.line}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Section>
