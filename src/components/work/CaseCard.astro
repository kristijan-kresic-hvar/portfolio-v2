---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Flagship treatment: split text/cover composition spanning the full row. */
  wide?: boolean;
}

const { entry, wide = false } = Astro.props;
const { title, outcome, summary, role, stack, year, cover, coverPeek, coverAlt } = entry.data;

// Layered composition per the locked 2026-07-18 decision: dashboard frame offset
// on the dark card + amber glow, signature frame peeking. Component-level CSS —
// never baked into the image files.
const covers = import.meta.glob<{ default: ImageMetadata }>('/src/assets/work/*.webp', {
  eager: true,
});
const coverImage = cover ? covers[`/src/assets/work/${cover}`]?.default : undefined;
const peekImage = coverPeek ? covers[`/src/assets/work/${coverPeek}`]?.default : undefined;

const meta = [role, ...stack, String(year)].join(' · ');
---

<article
  class:list={[
    'group border-border-subtle bg-bg-elev-1 ease-standard hover:border-border-default hover:shadow-card-hover has-[a:focus-visible]:border-border-default has-[a:focus-visible]:shadow-card-hover relative h-full overflow-hidden rounded-xl border transition duration-(--duration-fast)',
    wide ? 'flex flex-col lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]' : 'flex flex-col',
  ]}
>
  <div class:list={['flex flex-col p-6 sm:p-8', wide && 'lg:p-10']}>
    <h3
      class:list={[
        'text-text-primary font-bold tracking-tight text-balance',
        wide ? 'text-2xl lg:text-3xl' : 'text-xl sm:text-2xl',
      ]}
    >
      {
        /* Stretched link: the anchor names the card for screen readers, its ::after
        makes the whole card the tap target. z-10 lifts that overlay above the cover
        composition — positioned and later in the DOM, so it would otherwise leave
        only the text half clickable. */
      }
      <a
        href={`/work/${entry.id}`}
        class="after:absolute after:inset-0 after:z-10 after:content-['']"
      >
        {title}
      </a>
    </h3>
    {
      outcome && (
        <p
          class:list={[
            'text-accent-text mt-3 font-medium text-pretty',
            wide ? 'text-lg lg:text-xl' : 'text-base',
          ]}
        >
          {outcome}
        </p>
      )
    }
    <p class="text-text-body mt-3 text-sm text-pretty">{summary}</p>
    <p class="text-text-muted mt-auto pt-6 font-mono text-xs leading-relaxed">{meta}</p>
  </div>
  {
    coverImage && (
      <div
        class:list={[
          'relative',
          wide ? 'mt-2 aspect-[16/10] lg:mt-0 lg:aspect-auto lg:min-h-96' : 'mt-2 aspect-[16/10]',
        ]}
      >
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-[radial-gradient(85%_80%_at_70%_38%,var(--color-accent-glow),transparent_78%)] mask-y-from-85% mask-x-from-85%"
        />
        {peekImage && (
          <div
            class:list={[
              'border-border-subtle shadow-card absolute aspect-[16/10] -rotate-2 overflow-hidden rounded-md border opacity-80',
              wide
                ? 'top-10 left-2 w-[55%] lg:top-16 lg:left-0 lg:w-[48%]'
                : 'top-10 left-2 w-[55%] sm:left-4',
            ]}
          >
            <Picture
              src={peekImage}
              formats={['avif']}
              fallbackFormat="webp"
              width={640}
              widths={[400, 640]}
              sizes="(min-width: 1024px) 20vw, 45vw"
              loading="lazy"
              alt=""
              class="h-full w-full object-cover object-left-top"
            />
          </div>
        )}
        <div
          class:list={[
            'border-border-default shadow-elevated absolute overflow-hidden rounded-tl-lg border',
            wide
              ? 'top-4 left-[18%] w-[105%] lg:top-8 lg:left-[12%] lg:w-[108%]'
              : 'top-4 left-[18%] w-[105%]',
          ]}
        >
          <Picture
            src={coverImage}
            formats={['avif']}
            fallbackFormat="webp"
            width={1280}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 45vw, 90vw"
            loading="lazy"
            alt={coverAlt ?? `${title} — product screenshot`}
            class="h-auto w-full"
          />
        </div>
      </div>
    )
  }
</article>
