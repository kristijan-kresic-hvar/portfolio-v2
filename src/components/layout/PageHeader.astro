---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<header>
  {eyebrow && <p class="text-text-muted font-mono text-xs tracking-wide uppercase">{eyebrow}</p>}
  <h1 class:list={['text-text-primary text-4xl font-bold tracking-tight', eyebrow && 'mt-4']}>
    {title}
  </h1>
  {description && <p class="text-text-body mt-4 max-w-xl text-lg">{description}</p>}
</header>
