---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  elevated?: boolean;
}

const { elevated = false, class: className, ...rest } = Astro.props;
---

<div
  class:list={[
    'border-border-subtle ease-standard hover:border-border-default hover:shadow-card-hover rounded-lg border p-6 transition duration-(--duration-fast)',
    elevated ? 'bg-bg-elev-1' : 'bg-bg-base',
    className,
  ]}
  {...rest}
>
  <slot />
</div>
