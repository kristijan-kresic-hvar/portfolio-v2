---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
}

const { href, class: className, ...rest } = Astro.props;
---

<a
  href={href}
  class:list={[
    'text-accent ease-standard hover:text-accent-hover underline underline-offset-2 transition-colors duration-(--duration-fast)',
    className,
  ]}
  {...rest}><slot /></a
>
