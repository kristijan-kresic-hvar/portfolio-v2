# Site
PUBLIC_SITE_URL=https://kristijankresic.com

# Anthropic API — Brief generation (Phase 6, post-launch; runs as a scheduled GitHub Action)
ANTHROPIC_API_KEY=
BRIEF_MODEL=claude-sonnet-5

# GitHub — Brief PR creation. Only needed when running the Brief script OUTSIDE GitHub
# Actions (local debug); inside Actions the built-in GITHUB_TOKEN is used instead.
GITHUB_TOKEN=
GITHUB_REPO=kristijan-kresic-hvar/portfolio-v2

# Resend — contact form + Brief failure alerts
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@kristijankresic.com
RESEND_TO_EMAIL=kristijan.kresic.dev@gmail.com

# Notifications
BRIEF_NOTIFY_EMAIL=kristijan.kresic.dev@gmail.com
